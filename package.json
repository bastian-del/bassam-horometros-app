{
  "name": "bassam-horometros-app",
  "version": "1.0.0",
  "description": "Aplicación de control de horómetros diarios para BASSAM SPA",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "BASSAM SPA",
  "license": "MIT",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "build": "npm run react-build && npm run electron-build",
    "electron-build": "electron-builder",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "dist": "npm run react-build && electron-builder --publish=never",
    "dist-win": "npm run react-build && electron-builder --win",
    "dist-mac": "npm run react-build && electron-builder --mac",
    "dist-linux": "npm run react-build && electron-builder --linux"
  },
  "build": {
    "appId": "com.bassam.horometros",
    "productName": "BASSAM Horómetros",
    "files": [
      "build/**/*",
      "public/electron.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BASSAM Horómetros"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scripts": "5.0.1",
    "jspdf": "^4.2.1",
    "html2canvas": "^1.4.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "concurrently": "^10.0.5",
    "wait-on": "^9.1.0",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
